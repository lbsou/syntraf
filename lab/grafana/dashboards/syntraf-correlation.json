  "templating": {
    "list": [
      {
        "name": "mesh_group",
        "label": "Groupe",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "syntraf-vm"
        },
        "query": {
          "query": "label_values(SYNTRAF_RX_PCT_LOSS, MESH_GROUP)",
          "refId": "v"
        },
        "definition": "label_values(SYNTRAF_RX_PCT_LOSS, MESH_GROUP)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "client",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "syntraf-vm"
        },
        "query": {
          "query": "label_values(SYNTRAF_RX_PCT_LOSS, CLIENT)",
          "refId": "v"
        },
        "definition": "label_values(SYNTRAF_RX_PCT_LOSS, CLIENT)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
