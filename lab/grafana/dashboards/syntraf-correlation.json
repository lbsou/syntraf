{
  "uid": "syntraf-correlation",
  "title": "SYNTRAF — corrélations entre flux",
  "tags": [
    "syntraf",
    "lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Tableaux de bord SYNTRAF",
      "type": "dashboards",
      "tags": [
        "syntraf"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "mesh_group",
        "label": "MESH_GROUP",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "syntraf-vm"
        },
        "query": {
          "query": "label_values(SYNTRAF_RX_PCT_LOSS, MESH_GROUP)",
          "refId": "v"
        },
        "definition": "label_values(SYNTRAF_RX_PCT_LOSS, MESH_GROUP)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "client",
        "label": "CLIENT",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "syntraf-vm"
        },
        "query": {
          "query": "label_values(SYNTRAF_RX_PCT_LOSS, CLIENT)",
          "refId": "v"
        },
        "definition": "label_values(SYNTRAF_RX_PCT_LOSS, CLIENT)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "server",
        "label": "SERVER",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "syntraf-vm"
        },
        "query": {
          "query": "label_values(SYNTRAF_RX_PCT_LOSS, SERVER)",
          "refId": "v"
        },
        "definition": "label_values(SYNTRAF_RX_PCT_LOSS, SERVER)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Changements de configuration",
        "datasource": {
          "type": "prometheus",
          "uid": "syntraf-vm"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "last_over_time(SYNTRAF_CONFIG_CHANGE[1m])",
        "step": "60s",
        "titleFormat": "{{ACTION}}",
        "textFormat": "{{SUMMARY}} — {{ACTOR}}",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Corrélation des pertes entre flux",
      "description": "Corrélation de Pearson entre flux sur les 15 dernières minutes (un point toutes les 10 s), recalculée chaque minute par le serveur. Rouge : ces flux se dégradent ensemble (lien, équipement ou goulot commun probable). Les flux sans variation (aucune perte) n'apparaissent pas.",
      "datasource": {
        "type": "prometheus",
        "uid": "syntraf-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "syntraf-vm"
          },
          "expr": "label_del(last_over_time(SYNTRAF_CORRELATION_LOSS[5m]), \"__name__\")",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "FLOW_B",
            "rowField": "FLOW_A",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3274d9",
                "value": null
              },
              {
                "color": "#555555",
                "value": -0.3
              },
              {
                "color": "#555555",
                "value": 0.3
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "no data",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "FLOW_A\\FLOW_B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Flux ↓ / Flux →"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 2,
      "type": "table",
