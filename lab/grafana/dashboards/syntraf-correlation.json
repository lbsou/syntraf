  "annotations": {
    "list": [
      {
        "name": "Changements de configuration",
        "datasource": {
          "type": "prometheus",
          "uid": "syntraf-vm"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "last_over_time(SYNTRAF_CONFIG_CHANGE[1m])",
        "step": "60s",
        "titleFormat": "{{ACTION}}",
        "textFormat": "{{SUMMARY}} — {{ACTOR}}",
        "useValueForTime": false
      },
      {
        "name": "Alertes",
        "datasource": {
          "type": "prometheus",
          "uid": "syntraf-vm"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "last_over_time(SYNTRAF_ALERT_EVENT[1m])",
        "step": "60s",
        "titleFormat": "Alerte {{ACTION}} · {{METRIC}} · {{FLOW}}",
        "textFormat": "{{MESH_GROUP}} — {{SUMMARY}}",
        "useValueForTime": false
      },
      {
        "name": "Redémarrages et mises à jour",
        "datasource": {
          "type": "prometheus",
          "uid": "syntraf-vm"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "last_over_time(SYNTRAF_LIFECYCLE_EVENT[1m])",
        "step": "60s",
        "titleFormat": "{{EVENT}} · {{SUBJECT}}",
        "textFormat": "{{SUMMARY}}",
        "useValueForTime": false
      },
      {
        "name": "Maintenance",
        "datasource": {
          "type": "prometheus",
          "uid": "syntraf-vm"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "max by (UID, TARGET_TYPE, TARGET, DESCRIPTION) (SYNTRAF_MAINTENANCE_ACTIVE)",
        "step": "60s",
        "titleFormat": "Maintenance {{UID}} · {{TARGET}}",
        "textFormat": "{{DESCRIPTION}} — alertes suspendues",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Corrélation des pertes",
      "description": "Corrélation de Pearson entre flux sur les 15 dernières minutes (un point toutes les 10 s), recalculée chaque minute par le serveur. Rouge : ces flux se dégradent ensemble (lien, équipement ou goulot commun probable). Les flux sans variation (aucune perte) n'apparaissent pas.",
      "datasource": {
        "type": "prometheus",
        "uid": "syntraf-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "syntraf-vm"
          },
          "expr": "sort_by_label(label_del(last_over_time(SYNTRAF_CORRELATION_LOSS[5m]), \"__name__\"), \"FLOW_B\", \"FLOW_A\")",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "FLOW_B",
            "rowField": "FLOW_A",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3274d9",
                "value": null
              },
              {
                "color": "#555555",
                "value": -0.3
              },
              {
                "color": "#555555",
                "value": 0.3
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "no data",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "—",
                  "color": "transparent",
                  "index": 1
                }
              }
            },
            {
              "type": "value",
              "options": {
                "-2": {
                  "text": "NAT ↔ NAT",
                  "color": "transparent",
                  "index": 2
                }
              }
            }
          ],
          "custom": {
            "align": "center",
            "minWidth": 70,
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "FLOW_A\\FLOW_B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Flux ↓  Flux →"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Flux ↓  Flux →",
            "desc": false
          }
        ]
      }
    },
