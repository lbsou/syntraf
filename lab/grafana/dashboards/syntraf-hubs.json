          "expr": "last_over_time(SYNTRAF_GROUP_INFO{MESH_GROUP=~\"$mesh_group\"}[90s]) and (tlast_over_time(SYNTRAF_GROUP_INFO{MESH_GROUP=~\"$mesh_group\"}[90s]) >= scalar(max(tlast_over_time(SYNTRAF_GROUP_INFO{MESH_GROUP=~\"$mesh_group\"}[90s]))) - 5)"
