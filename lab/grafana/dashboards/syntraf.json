          "expr": "SYNTRAF_RX_BITRATE{MESH_GROUP=~\"$mesh_group\",CLIENT=~\"$client\",SERVER=~\"$server\"}",
          "legendFormat": "{{CLIENT}} → {{SERVER}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "syntraf-vm"
          },
          "legendFormat": "débit prévu · {{MESH_GROUP}}",
          "expr": "max by (MESH_GROUP) (last_over_time(SYNTRAF_GROUP_BANDWIDTH_KBPS{MESH_GROUP=~\"$mesh_group\"}[40s]))"
        }
