  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Tableaux de bord SYNTRAF",
      "type": "dashboards",
      "tags": [
        "syntraf"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
