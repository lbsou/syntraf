    {
      "id": 1,
      "type": "table",
      "title": "Alertes ouvertes",
      "description": "Alertes hors baseline de SYNTRAF (page Alertes de l'interface) : une mesure sortie de la norme apprise de son flux, du mauvais côté. Les flux encore en apprentissage (moins de 24 h d'historique) n'y figurent pas. Nombre de métriques en alerte sur chaque flux ; « OK » : aucune. « NAT ↔ NAT » : deux sondes derrière un NAT ne peuvent pas se joindre ; la paire n'est pas mesurée.",
      "datasource": {
        "type": "prometheus",
        "uid": "syntraf-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "syntraf-vm"
          },
          "expr": "sort_by_label(label_del(((sum by (CLIENT, SERVER) (last_over_time(SYNTRAF_BASELINE_ALERT{MESH_GROUP=~\"$mesh_group\",CLIENT=~\"$client\",SERVER=~\"$server\",METRIC!=\"tcp\"}[3m]))) or ((max by (CLIENT, SERVER) (last_over_time(SYNTRAF_FLOW_NAT_PAIR{MESH_GROUP=~\"$mesh_group\",CLIENT=~\"$client\",SERVER=~\"$server\"}[90s])) * 0 + -2) unless on(CLIENT, SERVER) (sum by (CLIENT, SERVER) (last_over_time(SYNTRAF_BASELINE_ALERT{MESH_GROUP=~\"$mesh_group\",CLIENT=~\"$client\",SERVER=~\"$server\",METRIC!=\"tcp\"}[3m]))))), \"__name__\"), \"SERVER\", \"CLIENT\")",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "SERVER",
            "rowField": "CLIENT",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "no data",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "—",
                  "color": "transparent",
                  "index": 1
                }
              }
            },
            {
              "type": "value",
              "options": {
                "-2": {
                  "text": "NAT ↔ NAT",
                  "color": "transparent",
                  "index": 2
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 4
                }
              }
            }
          ],
          "custom": {
            "align": "center",
            "minWidth": 70,
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CLIENT\\SERVER"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "De ↓  Vers →"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "De ↓  Vers →",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Alertes ouvertes · détail",
      "datasource": {
        "type": "prometheus",
        "uid": "syntraf-vm"
      },
      "description": "Alertes hors baseline de SYNTRAF (page Alertes de l'interface) : une mesure sortie de la norme apprise de son flux, du mauvais côté. Les flux encore en apprentissage (moins de 24 h d'historique) n'y figurent pas. Écart : 1 = au seuil, 2 = deux fois plus loin que le seuil.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "syntraf-vm"
          },
          "instant": true,
          "format": "table",
          "expr": "last_over_time(SYNTRAF_BASELINE_SCORE{MESH_GROUP=~\"$mesh_group\",CLIENT=~\"$client\",SERVER=~\"$server\"}[3m]) and on(MESH_GROUP, CLIENT, SERVER, METRIC, DIRECTION, TEST) (last_over_time(SYNTRAF_BASELINE_ALERT{MESH_GROUP=~\"$mesh_group\",CLIENT=~\"$client\",SERVER=~\"$server\"}[3m]) == 1)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "MESH_GROUP": 0,
              "CLIENT": 1,
              "SERVER": 2,
              "METRIC": 3,
              "Value": 4
            },
            "renameByName": {
              "MESH_GROUP": "Groupe",
              "CLIENT": "Source",
              "SERVER": "Destination",
              "METRIC": "Métrique",
              "Value": "Écart (× seuil)",
              "DIRECTION": "Sens",
              "TEST": "Test"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "noValue": "Aucune alerte ouverte",
          "custom": {
            "align": "left"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
