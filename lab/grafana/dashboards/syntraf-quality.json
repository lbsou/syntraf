      "datasource": {
        "type": "prometheus",
        "uid": "syntraf-vm"
      },
      "description": "Valeurs en vigueur, profil appliqué. Paquets/s = débit par flux ÷ (taille × 8).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
