    {
      "id": 1,
      "type": "table",
      "title": "Débit · dernier test",
      "description": "Tests TCP planifiés (page Tests TCP de SYNTRAF), un point par test. Lu dans le sens des données : en ligne la sonde qui envoie, en colonne celle qui reçoit. Débit reçu, sans les premières secondes (-O). « NAT ↔ NAT » : deux sondes derrière un NAT ne peuvent pas se joindre ; la paire n'est pas mesurée.",
      "datasource": {
        "type": "prometheus",
        "uid": "syntraf-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "syntraf-vm"
          },
          "expr": "sort_by_label(label_del(((max by (SRC, DST) ((label_replace(label_replace(last_over_time(SYNTRAF_TCP_BITRATE_MBPS{MESH_GROUP=~\"$mesh_group\",CLIENT=~\"$client\",SERVER=~\"$server\",TEST=~\"$test\",DIRECTION=~\"$direction\",DIRECTION=\"upload\"}[7d]), \"SRC\", \"$1\", \"SERVER\", \"(.*)\"), \"DST\", \"$1\", \"CLIENT\", \"(.*)\") or label_replace(label_replace(last_over_time(SYNTRAF_TCP_BITRATE_MBPS{MESH_GROUP=~\"$mesh_group\",CLIENT=~\"$client\",SERVER=~\"$server\",TEST=~\"$test\",DIRECTION=~\"$direction\",DIRECTION=\"download\"}[7d]), \"SRC\", \"$1\", \"CLIENT\", \"(.*)\"), \"DST\", \"$1\", \"SERVER\", \"(.*)\")))) or ((max by (SRC, DST) (label_replace(label_replace(max by (CLIENT, SERVER) (last_over_time(SYNTRAF_FLOW_NAT_PAIR{MESH_GROUP=~\"$mesh_group\"}[90s])), \"SRC\", \"$1\", \"CLIENT\", \"(.*)\"), \"DST\", \"$1\", \"SERVER\", \"(.*)\")) * 0 + -2) unless on(SRC, DST) (max by (SRC, DST) ((label_replace(label_replace(last_over_time(SYNTRAF_TCP_BITRATE_MBPS{MESH_GROUP=~\"$mesh_group\",CLIENT=~\"$client\",SERVER=~\"$server\",TEST=~\"$test\",DIRECTION=~\"$direction\",DIRECTION=\"upload\"}[7d]), \"SRC\", \"$1\", \"SERVER\", \"(.*)\"), \"DST\", \"$1\", \"CLIENT\", \"(.*)\") or label_replace(label_replace(last_over_time(SYNTRAF_TCP_BITRATE_MBPS{MESH_GROUP=~\"$mesh_group\",CLIENT=~\"$client\",SERVER=~\"$server\",TEST=~\"$test\",DIRECTION=~\"$direction\",DIRECTION=\"download\"}[7d]), \"SRC\", \"$1\", \"CLIENT\", \"(.*)\"), \"DST\", \"$1\", \"SERVER\", \"(.*)\")))))), \"__name__\"), \"DST\", \"SRC\")",
          "instant": true,
          "range": false
        }
      ],
