* text=auto
*.sh text eol=lf
*.pxd    text diff=python
*.py     text diff=python
*.py3    text diff=python
*.pyw    text diff=python
*.pyx    text diff=python
*.pyz    text diff=python


# Mark vendored JavaScript libraries so GitHub doesn't count them in language statistics
lib/web_ui/static/** linguist-vendored
lib/web_ui_kindafixed2/static/** linguist-vendored
lib/webui_kindafixed/static/** linguist-vendored

# Exclude non-code files from language detection
crypto/* linguist-vendored
doc/* linguist-documentation
etc/* linguist-vendored

# Ensure Python is properly detected
*.py linguist-detectable=true
